{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-room.invalid/schemas/source.schema.json",
  "title": "Permitted source register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "accessedOn", "permitted", "status", "contribution"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "kind": { "enum": ["archive-internal", "official-release", "official-documentation", "official-issue", "package-registry"] },
          "locator": { "type": "string", "minLength": 1 },
          "accessedOn": { "type": "string", "format": "date" },
          "permitted": { "const": true },
          "status": { "enum": ["observed", "tested", "inferred", "uncertain", "implementation-specific"] },
          "contribution": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
