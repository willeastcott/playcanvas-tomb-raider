{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-room.invalid/schemas/input-tape.schema.json",
  "title": "Reference input tape",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "configId", "purpose", "sampling", "initialState", "events", "stopMarker"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "configId": { "const": "m0-reference-v1" },
    "purpose": { "type": "string", "minLength": 1 },
    "sampling": { "type": "string", "minLength": 1 },
    "initialState": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample", "action", "pressed"],
        "properties": {
          "sample": { "type": "integer", "minimum": 0 },
          "action": { "enum": ["run-forward", "small-jump-back", "turn-left", "turn-right", "walk", "jump", "action", "draw-weapon", "inventory-pause", "toggle-resolution", "reduce-viewport", "enlarge-viewport"] },
          "pressed": { "type": "boolean" }
        }
      }
    },
    "stopMarker": { "const": "m0-boot-complete-v1" }
  }
}
